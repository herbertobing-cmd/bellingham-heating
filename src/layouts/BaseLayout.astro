---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Bellingham Heating Repair",
  description = "Heating repair in Bellingham, WA",
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  {noindex && (
    <meta
      name="robots"
      content="noindex, nofollow"
    />
  )}

</head>

<body>

  <Navbar />

  <main>

    <slot />

  </main>

  <Footer />

</body>

</html>