---

<section class="services-hero">
  <div class="container hero-grid">

    <div class="hero-content">
      <span class="overline">
        HEATING REPAIR SERVICES
      </span>

      <h1>
        Heating Repair Services
        <span>in Bellingham</span>
      </h1>

      <p>
        Five things, done properly, across Whatcom County.
        We repair heating systems and we do not sell new ones,
        which keeps the advice clean.
      </p>

      <div class="hero-buttons">
        <a href="#contact" class="btn btn-primary">
          <span class="button-icon">▣</span>
          <span>BOOK A VISIT</span>
        </a>

        <a href="tel:+13605550143" class="call-link">
          <span class="phone-icon">☎</span>

          <span class="call-copy">
            <small>Call Now</small>
            <strong>(360) 555-0143</strong>
          </span>
        </a>
      </div>
    </div>

    <div class="hero-image">
      <img
        src="https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70b789369fa5db5b4922ef.png"
        alt="Technician repairing a heating system in Bellingham"
      />
    </div>

  </div>
</section>

<style>
.services-hero {
  padding: 42px 24px 0;
  background: #f8fafc;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 40%) minmax(0, 60%);
  min-height: 430px;
  max-width: 1200px;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #edf0f4;
  border-radius: 22px 22px 0 0;
  box-shadow: 0 18px 55px rgba(15, 23, 42, 0.09);
}

.hero-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 52px 50px 48px 58px;
}

.overline {
  display: inline-block;
  margin-bottom: 20px;
  color: #ea580c;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 2.5px;
}

.overline::after {
  content: "";
  display: block;
  width: 62px;
  height: 3px;
  margin-top: 10px;
  border-radius: 999px;
  background: #f97316;
}

.hero-content h1 {
  margin: 0 0 22px;
  color: #0f172a;
  font-size: clamp(2.35rem, 4vw, 3.45rem);
  font-weight: 850;
  line-height: 1.06;
  letter-spacing: -1.8px;
}
.hero-content h1{
    font-size:44px;
    line-height:1.1;
    letter-spacing:-1px;
    margin:12px 0 18px;
}
.hero-content p {
  max-width: 480px;
  margin: 0 0 34px;
  color: #475569;
  font-size: 1.08rem;
  line-height: 1.75;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  min-height: 58px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 15px 25px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 0.94rem;
  font-weight: 800;
  letter-spacing: 0.4px;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.btn-primary {
  color: #ffffff;
  background: #f97316;
  box-shadow: 0 12px 28px rgba(249, 115, 22, 0.24);
}

.btn-primary:hover {
  transform: translateY(-3px);
  background: #ea580c;
  box-shadow: 0 17px 36px rgba(234, 88, 12, 0.3);
}

.button-icon {
  font-size: 1rem;
}

.call-link {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  min-height: 58px;
  padding-left: 24px;
  border-left: 1px solid #e2e8f0;
  color: #0f172a;
  text-decoration: none;
}

.phone-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 50%;
  color: #ffffff;
  background: #0b2345;
  font-size: 1.05rem;
}

.call-copy {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.call-copy small {
  margin-bottom: 4px;
  color: #ea580c;
  font-size: 0.8rem;
  font-weight: 700;
}

.call-copy strong {
  color: #0f172a;
  font-size: 1.08rem;
}

.hero-image {
  position: relative;
  min-height: 430px;
  overflow: hidden;
  background: #111827;
}

.hero-image::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  z-index: 1;
  width: 70px;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.24),
    rgba(255, 255, 255, 0)
  );
  pointer-events: none;
}

.hero-image img {
  width: 100%;
  height: 100%;
  min-height: 430px;
  display: block;
  object-fit: cover;
  object-position: center center;
  transition: transform 0.6s ease;
}

.hero-grid:hover .hero-image img {
  transform: scale(1.025);
}

@media (max-width: 600px) {
 .services-hero{
    padding:0;
    background:#f8fafc;
}

.hero-grid{
    display:grid;
    grid-template-columns:45% 55%;
    align-items:center;
    gap:50px;

    max-width:1200px;
    margin:auto;
}
  .hero-content {
    padding: 44px 34px;
  }
.hero-image{

    display:flex;
    justify-content:center;
    align-items:center;

}

.hero-image img{

    width:100%;
    max-width:640px;

    height:380px;

    object-fit:cover;
    object-position:right center;

    border-radius:20px;

    box-shadow:
    0 20px 60px rgba(0,0,0,.18);

}

@media (max-width: 640px) {
  .services-hero {
    padding-inline: 12px;
  }

  .hero-content {
    padding: 36px 24px;
  }

  .hero-content h1 {
    font-size: 2.35rem;
    letter-spacing: -1px;
  }

  .hero-content p {
    font-size: 1rem;
  }

  .hero-buttons {
    align-items: stretch;
    flex-direction: column;
    gap: 16px;
  }

  .btn {
    width: 100%;
  }

  .call-link {
    width: 100%;
    padding: 16px 0 0;
    border-top: 1px solid #e2e8f0;
    border-left: 0;
  }

height:auto;
object-fit:contain;
min-height:auto;
}
</style>