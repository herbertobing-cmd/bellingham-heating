---
const services = [
  {
    title: "Furnace Repair",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70b472cf81b06f05ad26bd.png",
    description:
      "Gas, electric and oil furnaces. Ignition faults, short cycling, blower failures and more.",
  },
  {
    title: "Emergency Heating Repair",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70af54aad806c23e122074.png",
    description:
      "Fast response when your heating system stops working unexpectedly.",
  },
  {
    title: "Heat Pump Repair",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70b3d6a4c8a1a2c3b5965a.png",
    description:
      "Heat pumps that are icing over, running constantly or not heating properly.",
  },
  {
    title: "Furnace Maintenance",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70b60b369fa5db5b47e0e5.png",
    description:
      "Prevent breakdowns with seasonal cleaning, inspection and tune-ups.",
  },
  {
    title: "Ductless Mini Split Repair",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a70b4db497cd89d24c0a4ce.png",
    description:
      "Repair for wall-mounted mini split systems showing error codes or poor performance.",
  },
];
---

<section class="services-cards">
  <div class="container">

    <span class="section-label">OUR SERVICES</span>

    <h2>Five Things. Done Properly.</h2>

    <div class="cards">

      {services.map((service) => (

        <article class="card">

          <img src={service.image} alt={service.title} />

          <div class="card-content">

            <h3>{service.title}</h3>

            <p>{service.description}</p>

            <a href="#">Learn More →</a>

          </div>

        </article>

      ))}

    </div>

  </div>
</section>
<style>

.services-cards{
    padding:100px 0;
    background:#fff;
}

.section-label{
    display:block;
    text-align:center;
    color:#f97316;
    font-weight:700;
    letter-spacing:2px;
    font-size:.85rem;
    margin-bottom:10px;
}

.services-cards h2{
    text-align:center;
    font-size:52px;
    color:#0f172a;
    margin-bottom:60px;
}

.cards{
    display:flex;
    gap:24px;
    overflow-x:auto;
    padding-bottom:15px;
    scroll-behavior:smooth;
}

.card{
    background:#fff;
    border-radius:18px;
    overflow:hidden;
    border:1px solid #ececec;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
    transition:.35s;
    display:flex;
    flex-direction:column;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 25px 60px rgba(0,0,0,.15);
}

.card img{
    width:100%;
    height:150px;
    object-fit:cover;
    display:block;
}

.card{
    min-width:300px;
    flex:0 0 300px;

    background:#fff;
    border-radius:18px;
    overflow:hidden;
    border:1px solid #ececec;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
    transition:.35s;
}
.cards::-webkit-scrollbar{
    height:8px;
}

.cards::-webkit-scrollbar-thumb{
    background:#f97316;
    border-radius:20px;
}

.cards::-webkit-scrollbar-track{
    background:#f3f4f6;
}
.card h3{
    font-size:25px;
    margin-bottom:14px;
    color:#111827;
}

.card p{
    color:#555;
    line-height:1.8;
    flex:1;
}

.card a{
    margin-top:25px;
    color:#f97316;
    font-weight:700;
    text-decoration:none;
}

.card a:hover{
    color:#c2410c;
}

</style>