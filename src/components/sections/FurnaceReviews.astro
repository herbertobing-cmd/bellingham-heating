---
const reviews = [
  {
    name: "Michael R.",
    location: "Bellingham",
    text: "Our furnace stopped overnight. They diagnosed the issue quickly, explained everything clearly, and had the heat back on the same afternoon."
  },
  {
    name: "Sarah T.",
    location: "Ferndale",
    text: "No pressure to replace the furnace. They repaired the failed part, showed me what happened, and saved us a lot of money."
  },
  {
    name: "James L.",
    location: "Lynden",
    text: "Professional, on time and honest. I appreciated the written explanation and the straightforward pricing."
  }
];
---

<section class="furnace-reviews">
  <div class="container">
    <div class="section-header">
      <span class="overline">CUSTOMER REVIEWS</span>
      <h2>What Homeowners Are Saying</h2>
      <p>Real experiences from homeowners across Whatcom County.</p>
    </div>

    <div class="reviews-grid">
      {reviews.map((review) => (
        <article class="review-card">
          <div class="quote">“</div>

          <div class="stars">
            ★★★★★
          </div>

          <p class="review-text">{review.text}</p>

          <div class="review-footer">
            <strong>{review.name}</strong>
            <span>{review.location}, WA</span>
          </div>
        </article>
      ))}
    </div>

    <div class="reviews-cta">
      <a href="#contact" class="btn">Book a Furnace Repair Visit</a>
    </div>

  </div>
</section>

<style>
.furnace-reviews{
padding:110px 24px;
background:#fff;
}

.container{width:min(1180px,100%);margin:auto;}

.section-header{text-align:center;max-width:760px;margin:0 auto 60px;}

.overline{
display:inline-block;
color:#ea580c;
font-size:.8rem;
font-weight:800;
letter-spacing:2px;
margin-bottom:16px;
}

.overline::after{
content:"";
display:block;
width:64px;
height:3px;
background:#f97316;
margin:10px auto 0;
border-radius:999px;
}

.section-header h2{
font-size:clamp(2.2rem,4vw,3.2rem);
margin:0 0 18px;
color:#0f172a;
}

.section-header p{
color:#64748b;
font-size:1.05rem;
line-height:1.8;
}

.reviews-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:28px;
}

.review-card{
position:relative;
padding:34px;
border:2px solid #e8edf3;
border-radius:20px;
background:#fff;
transition:.35s;
box-shadow:0 12px 32px rgba(15,23,42,.05);
overflow:hidden;
}

.review-card::before{
content:"";
position:absolute;
left:0;top:0;
width:100%;
height:4px;
background:#f97316;
transform:scaleX(0);
transform-origin:left;
transition:.35s;
}

.review-card:hover{
transform:translateY(-8px);
border-color:#f97316;
box-shadow:0 0 22px rgba(249,115,22,.16),0 22px 50px rgba(15,23,42,.12);
}

.review-card:hover::before{
transform:scaleX(1);
}

.quote{
font-size:70px;
line-height:.8;
color:#fde6d3;
font-weight:900;
}

.stars{
color:#f97316;
font-size:20px;
margin:8px 0 18px;
letter-spacing:2px;
}

.review-text{
color:#64748b;
line-height:1.8;
margin-bottom:28px;
}

.review-footer strong{
display:block;
color:#0f172a;
margin-bottom:4px;
}

.review-footer span{
color:#94a3b8;
font-size:.92rem;
}

.reviews-cta{
margin-top:48px;
text-align:center;
}

.btn{
display:inline-block;
padding:16px 30px;
background:#f97316;
color:#fff;
font-weight:800;
text-decoration:none;
border-radius:12px;
transition:.35s;
box-shadow:0 15px 35px rgba(249,115,22,.28);
}

.btn:hover{
background:#ea580c;
transform:translateY(-4px);
}

@media(max-width:991px){
.reviews-grid{
grid-template-columns:1fr;
}
}
</style>
