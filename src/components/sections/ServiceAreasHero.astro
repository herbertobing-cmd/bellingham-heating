<section class="areas-hero">

  <div class="container hero-grid">

    <div class="hero-content">

      <span class="overline">
        SERVICE AREAS
      </span>

      <h1>
        Heating Repair Across
        <span>Whatcom County</span>
      </h1>

      <p>
        We are a mobile heating repair service based in Bellingham,
        covering communities across Whatcom County from the waterfront
        to the foothills. Find your town below and see how we can help.
      </p>

      <div class="hero-buttons">

        <a
          href="tel:+13605550143"
          class="btn btn-primary"
        >
          Call (360) 555-0143
        </a>

        <a
          href="#contact"
          class="btn btn-secondary"
        >
          Request a Visit
        </a>

      </div>

    </div>

    <div class="hero-image">

      <img
        src="https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a727d1dfcee90cf63caeb2f.png"
        alt="Heating repair service across Whatcom County"
      />

    </div>

  </div>

</section>

<style>

.areas-hero{

padding:110px 24px;

background:
linear-gradient(180deg,#fff,#f8fafc);

}

.container{

width:min(1200px,100%);

margin:auto;

}

.hero-grid{

display:grid;

grid-template-columns:1fr 560px;

gap:60px;

align-items:center;

}

.overline{

display:inline-block;

margin-bottom:18px;

font-size:.8rem;

font-weight:800;

letter-spacing:2px;

color:#ea580c;

}

.overline::after{

content:"";

display:block;

width:64px;

height:3px;

margin-top:10px;

border-radius:999px;

background:#f97316;

}

.hero-content h1{

margin:0 0 24px;

font-size:clamp(2.8rem,5vw,4.5rem);

line-height:1.05;

color:#0f172a;

letter-spacing:-1px;

}

.hero-content h1 span{

display:block;

color:#ea580c;

}

.hero-content p{

font-size:1.08rem;

line-height:1.9;

color:#64748b;

margin-bottom:36px;

max-width:620px;

}

.hero-buttons{

display:flex;

gap:18px;

flex-wrap:wrap;

}

.btn{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 30px;

border-radius:14px;

font-weight:700;

text-decoration:none;

transition:.35s;

}

.btn-primary{

background:#ea580c;

color:#fff;

box-shadow:0 18px 38px rgba(234,88,12,.25);

}

.btn-primary:hover{

transform:translateY(-5px);

background:#c2410c;

}

.btn-secondary{

border:2px solid #ea580c;

color:#ea580c;

background:#fff;

}

.btn-secondary:hover{

background:#ea580c;

color:#fff;

}

.hero-image{

overflow:hidden;

border-radius:24px;

box-shadow:0 25px 60px rgba(15,23,42,.15);

}

.hero-image img{

width:100%;

height:650px;

display:block;

object-fit:cover;

transition:.6s;

}

.hero-image:hover img{

transform:scale(1.05);

}

@media(max-width:991px){

.hero-grid{

grid-template-columns:1fr;

}

.hero-image img{

height:420px;

}

}

</style>