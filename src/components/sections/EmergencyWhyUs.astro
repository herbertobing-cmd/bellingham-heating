---

const reasons = [
  "Restore safe heat as quickly as possible",
  "Protect elderly people and young children",
  "Help reduce the risk of frozen pipes",
  "Make sure the system is safe to leave running overnight"
];

---

<section class="emergency-why">
  <div class="container">

    <div class="section-header">
      <span class="overline">WHY EMERGENCIES ARE DIFFERENT</span>

      <h2>
        Why Call Us at Nine in the Evening
        <span>Instead of Nine Tomorrow Morning?</span>
      </h2>
    </div>

    <div class="why-grid">

      <div class="why-image">
        <img
          src="/images/svc-emergency-night.webp"
          alt="Emergency heating technician working at night"
        />
      </div>

      <div class="why-content">

        <p>
          An emergency repair is not simply a daytime repair completed after
          business hours.
        </p>

        <p>
          During normal appointments there is time to compare options,
          schedule follow-up work and wait for parts if needed.
        </p>

        <p>
          During an emergency our first priority is restoring safe heat,
          protecting vulnerable family members, helping prevent frozen pipes
          and making sure your heating equipment is safe to operate overnight.
        </p>

        <ul class="benefits">
          {
            reasons.map(reason => (
              <li>{reason}</li>
            ))
          }
        </ul>

        <a href="tel:+13605550143" class="cta">
          Call Now
        </a>

      </div>

    </div>

  </div>
</section>

<style>

.emergency-why{
padding:110px 24px;
background:#f8fafc;
}

.container{
width:min(1200px,100%);
margin:auto;
}

.section-header{
text-align:center;
max-width:760px;
margin:0 auto 60px;
}

.overline{
display:inline-block;
font-size:.8rem;
font-weight:800;
letter-spacing:2px;
color:#ea580c;
margin-bottom:18px;
}

.overline::after{
content:"";
display:block;
width:60px;
height:3px;
background:#f97316;
margin:10px auto 0;
border-radius:999px;
}

.section-header h2{
font-size:clamp(2.3rem,4vw,3.4rem);
line-height:1.1;
color:#0f172a;
margin:0;
}

.section-header span{
display:block;
}

.why-grid{
display:grid;
grid-template-columns:520px 1fr;
gap:60px;
align-items:center;
}

.why-image{
overflow:hidden;
border-radius:24px;
box-shadow:0 25px 60px rgba(15,23,42,.15);
}

.why-image img{
width:100%;
height:640px;
display:block;
object-fit:cover;
transition:.6s;
}

.why-image:hover img{
transform:scale(1.05);
}

.why-content p{
font-size:1.05rem;
line-height:1.9;
color:#64748b;
margin-bottom:22px;
}

.benefits{
margin:35px 0;
padding:0;
list-style:none;
display:grid;
gap:16px;
}

.benefits li{
position:relative;
padding-left:34px;
font-weight:600;
color:#334155;
}

.benefits li::before{
content:"✓";
position:absolute;
left:0;
top:0;
width:22px;
height:22px;
display:grid;
place-items:center;
background:#f97316;
color:#fff;
border-radius:50%;
font-size:.8rem;
}

.cta{
display:inline-flex;
align-items:center;
justify-content:center;
padding:16px 34px;
border-radius:12px;
background:#ea580c;
color:#fff;
font-weight:700;
text-decoration:none;
transition:.35s;
box-shadow:0 15px 30px rgba(234,88,12,.25);
}

.cta:hover{
transform:translateY(-4px);
background:#c2410c;
}

@media(max-width:991px){

.why-grid{
grid-template-columns:1fr;
}

.why-image img{
height:420px;
}

}

</style>