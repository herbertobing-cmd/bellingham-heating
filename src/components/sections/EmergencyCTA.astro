<section class="emergency-cta">

  <div class="container">

    <div class="cta-box">

      <span class="overline">
        NEED HELP NOW?
      </span>

      <h2>
        No Heat Tonight?
        <span>We're Ready to Help.</span>
      </h2>

      <p>
        If your furnace or heat pump has completely stopped, don't wait until
        the house becomes dangerously cold. Call us now and we'll help you
        decide the safest next step.
      </p>

      <div class="cta-buttons">

        <a href="tel:+13605550143" class="btn-primary">
          📞 Call Now
        </a>

        <a href="/contact" class="btn-secondary">
          Request Service
        </a>

      </div>

      <div class="trust-items">

        <div>✔ Honest Advice</div>

        <div>✔ Emergency Response</div>

        <div>✔ Furnace & Heat Pump Repair</div>

      </div>

    </div>

  </div>

</section>

<style>

.emergency-cta{

padding:110px 24px;

background:
linear-gradient(135deg,#0f172a,#1e293b);

}

.container{

width:min(1200px,100%);

margin:auto;

}

.cta-box{

padding:80px;

border-radius:28px;

text-align:center;

background:
linear-gradient(135deg,#111827,#1e293b);

border:1px solid rgba(255,255,255,.08);

box-shadow:
0 30px 70px rgba(0,0,0,.35);

}

.overline{

display:inline-block;

color:#fb923c;

font-weight:800;

letter-spacing:2px;

margin-bottom:18px;

font-size:.8rem;

}

.overline::after{

content:"";

display:block;

width:70px;

height:3px;

margin:10px auto 0;

background:#f97316;

border-radius:999px;

}

.cta-box h2{

margin:0 0 24px;

font-size:clamp(2.5rem,4vw,4rem);

line-height:1.1;

color:#fff;

}

.cta-box h2 span{

display:block;

color:#fb923c;

}

.cta-box p{

max-width:760px;

margin:0 auto 40px;

font-size:1.1rem;

line-height:1.9;

color:#cbd5e1;

}

.cta-buttons{

display:flex;

justify-content:center;

gap:18px;

flex-wrap:wrap;

margin-bottom:45px;

}

.btn-primary{

padding:18px 38px;

background:#f97316;

color:#fff;

text-decoration:none;

border-radius:14px;

font-weight:700;

transition:.35s;

box-shadow:
0 20px 40px rgba(249,115,22,.35);

}

.btn-primary:hover{

transform:translateY(-5px);

background:#ea580c;

}

.btn-secondary{

padding:18px 38px;

border:2px solid rgba(255,255,255,.2);

color:#fff;

text-decoration:none;

border-radius:14px;

font-weight:700;

transition:.35s;

}

.btn-secondary:hover{

background:#fff;

color:#0f172a;

transform:translateY(-5px);

}

.trust-items{

display:flex;

justify-content:center;

gap:30px;

flex-wrap:wrap;

color:#e2e8f0;

font-weight:600;

}

@media(max-width:768px){

.emergency-cta{

padding:80px 18px;

}

.cta-box{

padding:50px 28px;

}

.trust-items{

flex-direction:column;

gap:14px;

}

}

</style>