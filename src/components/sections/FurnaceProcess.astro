---
const steps = [
  {
    number: "01",
    title: "You Call or Send a Message",
    description:
      "Tell us what the furnace is doing and roughly how old it is. If you have no heat at all, say so when you call and we will prioritize it.",
    icon: "message",
  },
  {
    number: "02",
    title: "We Give You a Window and the Diagnostic Fee",
    description:
      "Before we drive out, you know when we are coming and what the visit costs. No vague afternoons.",
    icon: "calendar",
  },
  {
    number: "03",
    title: "We Listen Before We Touch It",
    description:
      "We run the furnace through a full heating cycle and watch what it does. A lot of the diagnosis happens here.",
    icon: "ear",
  },
  {
    number: "04",
    title: "We Test the Likely Causes in Order",
    description:
      "Ignition, flame signal, airflow, safeties and electrical. We work through it methodically instead of swapping parts and hoping.",
    icon: "search",
  },
  {
    number: "05",
    title: "We Quote the Repair and Wait for Your Yes",
    description:
      "You get the number before any work starts. If there is more than one sensible option, we explain both.",
    icon: "quote",
  },
  {
    number: "06",
    title: "We Fix It and Show You",
    description:
      "When the repair is done, we run the system again with you there so you can see it working, and we leave the written summary.",
    icon: "check",
  },
];
---

<section class="furnace-process">
  <div class="container">
    <header class="section-header">
      <span class="overline">OUR REPAIR PROCESS</span>

      <h2>How a Furnace Repair Visit Actually Goes</h2>

      <p>
        Clear steps, upfront pricing and no guesswork from the first call to
        the final system test.
      </p>
    </header>

    <div class="process-grid">
      {
        steps.map((step) => (
          <article class="process-card">
            <span class="step-number">{step.number}</span>

            <div class="icon-wrap" aria-hidden="true">
              {step.icon === "message" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                  <path d="M8 9h8M8 13h5" />
                </svg>
              )}

              {step.icon === "calendar" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M8 3v4M16 3v4M3 10h18" />
                  <path d="M8 14h3M8 17h6" />
                </svg>
              )}

              {step.icon === "ear" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9a6 6 0 1 1 10.6 3.8c-1.2 1.4-2.6 2.1-3.3 3.9-.5 1.3-1.5 2.3-2.9 2.3-1.8 0-3.4-1.4-3.4-3.2" />
                  <path d="M9 9a3 3 0 0 1 6 0c0 1.2-.6 2.1-1.5 2.8" />
                </svg>
              )}

              {step.icon === "search" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="m15.5 15.5 5 5" />
                  <path d="M8 10.5h5M10.5 8v5" />
                </svg>
              )}

              {step.icon === "quote" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M4 7h16v10H4z" />
                  <path d="M8 11h8M8 14h5" />
                  <path d="M7 7V4h10v3" />
                </svg>
              )}

              {step.icon === "check" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8 12 2.7 2.7L16.5 9" />
                </svg>
              )}
            </div>

            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .furnace-process {
    padding: 115px 24px;
    background:
      linear-gradient(
        180deg,
        rgba(248, 250, 252, 0.95),
        rgba(255, 255, 255, 1)
      );
  }

  .container {
    width: min(1200px, 100%);
    margin: 0 auto;
  }

  .section-header {
    max-width: 820px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .overline {
    display: inline-block;
    margin-bottom: 16px;
    color: #ea580c;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2.4px;
  }

  .overline::after {
    content: "";
    display: block;
    width: 64px;
    height: 3px;
    margin: 10px auto 0;
    border-radius: 999px;
    background: #f97316;
  }

  .section-header h2 {
    margin: 0 0 20px;
    color: #0f172a;
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -1.4px;
  }

  .section-header p {
    max-width: 690px;
    margin: 0 auto;
    color: #64748b;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .process-card {
    position: relative;
    min-height: 330px;
    padding: 36px;
    overflow: hidden;
    border: 2px solid #e7ebf0;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .process-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, #f97316, #fb923c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }

  .process-card:hover {
    transform: translateY(-10px);
    border-color: #f97316;
    box-shadow:
      0 0 24px rgba(249, 115, 22, 0.16),
      0 24px 55px rgba(15, 23, 42, 0.13);
  }

  .process-card:hover::before {
    transform: scaleX(1);
  }

  .step-number {
    position: absolute;
    top: 22px;
    right: 24px;
    color: rgba(15, 23, 42, 0.07);
    font-size: 3.7rem;
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 1;
    transition:
      color 0.35s ease,
      transform 0.35s ease;
  }

  .process-card:hover .step-number {
    color: rgba(249, 115, 22, 0.14);
    transform: scale(1.05);
  }

  .icon-wrap {
    display: grid;
    width: 70px;
    height: 70px;
    margin-bottom: 26px;
    place-items: center;
    border: 1px solid #fed7aa;
    border-radius: 18px;
    color: #ea580c;
    background: #fff7ed;
    animation: iconPulse 3s ease-in-out infinite;
    transition:
      transform 0.35s ease,
      color 0.35s ease,
      background 0.35s ease,
      box-shadow 0.35s ease;
  }

  .process-card:nth-child(2) .icon-wrap {
    animation-delay: 0.2s;
  }

  .process-card:nth-child(3) .icon-wrap {
    animation-delay: 0.4s;
  }

  .process-card:nth-child(4) .icon-wrap {
    animation-delay: 0.6s;
  }

  .process-card:nth-child(5) .icon-wrap {
    animation-delay: 0.8s;
  }

  .process-card:nth-child(6) .icon-wrap {
    animation-delay: 1s;
  }

  .card-icon {
    width: 34px;
    height: 34px;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s ease;
  }

  .process-card:hover .icon-wrap {
    color: #ffffff;
    background: #f97316;
    transform: translateY(-4px) scale(1.07);
    box-shadow:
      0 0 20px rgba(249, 115, 22, 0.35),
      0 14px 32px rgba(249, 115, 22, 0.24);
  }

  .process-card:hover .card-icon {
    transform: rotate(7deg) scale(1.08);
  }

  .process-card h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 1.35rem;
    line-height: 1.28;
    transition: color 0.35s ease;
  }

  .process-card:hover h3 {
    color: #ea580c;
  }

  .process-card p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #64748b;
    font-size: 1rem;
    line-height: 1.74;
  }

  @keyframes iconPulse {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.055);
    }
  }

  @media (max-width: 980px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .furnace-process {
      padding: 82px 16px;
    }

    .section-header {
      margin-bottom: 42px;
      text-align: left;
    }

    .overline::after {
      margin-left: 0;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }

    .process-card {
      min-height: auto;
      padding: 30px;
    }

    .step-number {
      font-size: 3.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-card,
    .process-card::before,
    .step-number,
    .icon-wrap,
    .card-icon {
      transition: none;
    }

    .icon-wrap {
      animation: none;
    }

    .process-card:hover,
    .process-card:hover .icon-wrap {
      transform: none;
    }
  }
</style>
