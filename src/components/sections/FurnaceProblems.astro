---
const problems = [
  {
    title: "No Heat",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a726f6e484bd694240fdbeb.png",
    description:
      "Your furnace runs but isn't producing warm air. We diagnose ignitors, gas valves, flame sensors and control boards.",
  },
  {
    title: "Blowing Cold Air",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a726fb9725d6d9e1be9ac87.png",
    description:
      "Cold air can be caused by thermostat issues, dirty flame sensors, overheating or ignition failures.",
  },
  {
    title: "Strange Noises",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a727139ee7ca3d1c41ffa12.png",
    description:
      "Grinding, squealing or rattling noises usually indicate worn motors, loose components or blower problems.",
  },
  {
    title: "Short Cycling",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a7271beee7ca3d1c4209584.png",
    description:
      "A furnace that constantly starts and stops wastes energy and usually needs professional diagnosis.",
  },
  {
    title: "Won't Turn On",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a727245df32aa3e168b841b.png",
    description:
      "Electrical faults, bad capacitors, safety switches or failed ignitors can keep your system from starting.",
  },
  {
    title: "Weak Airflow",
    image: "https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a727286f72284777be2c4bf.png",
    description:
      "Blocked filters, blower motors and duct restrictions reduce comfort throughout your home.",
  },
];
---

<section class="furnace-problems">

  <div class="container">

    <span class="section-label">
      COMMON FURNACE PROBLEMS
    </span>

    <h2>
      We Fix the Most Common Furnace Problems
    </h2>

    <p class="section-intro">
      Whether your furnace won't start, blows cold air or keeps shutting off,
      our technicians diagnose the issue quickly and repair it correctly.
    </p>

    <div class="problem-grid">

      {problems.map(problem => (

        <article class="problem-card">

          <img
            src={problem.image}
            alt={problem.title}
          />

          <div class="card-body">

            <h3>{problem.title}</h3>

            <p>{problem.description}</p>

          </div>

        </article>

      ))}

    </div>

  </div>

</section>

<style>

.furnace-problems{

padding:110px 0;

background:#f8fafc;

}

.section-label{

display:inline-block;

color:#f97316;

font-size:.8rem;

font-weight:800;

letter-spacing:2px;

margin-bottom:14px;

}

.furnace-problems h2{

font-size:48px;

margin-bottom:18px;

color:#0f172a;

}

.section-intro{

max-width:760px;

font-size:18px;

line-height:1.8;

color:#64748b;

margin-bottom:50px;

}

.problem-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:28px;

}

.problem-card{

background:#fff;

border-radius:18px;

overflow:hidden;

transition:.35s;

box-shadow:0 12px 30px rgba(0,0,0,.05);

}

.problem-card:hover{

transform:translateY(-8px);

box-shadow:0 30px 60px rgba(0,0,0,.12);

}

.problem-card img{

width:100%;

height:220px;

object-fit:cover;

display:block;

transition:.5s;

}

.problem-card:hover img{

transform:scale(1.06);

}

.card-body{

padding:28px;

}

.card-body h3{

margin-bottom:12px;

font-size:24px;

color:#0f172a;

}

.card-body p{

line-height:1.8;

color:#64748b;

}

@media(max-width:991px){

.problem-grid{

grid-template-columns:1fr;

}

}

</style>