---
const services = [
  {
    title: "Furnace Repair",
    description: "Gas, electric and oil furnace diagnosis and repair.",
    href: "/services/furnace-repair/",
    icon: "furnace"
  },
  {
    title: "Heat Pump Repair",
    description: "Fast troubleshooting and repair for heat pump systems.",
    href: "/services/heat-pump-repair/",
    icon: "heatpump"
  },
  {
    title: "Emergency Heating Repair",
    description: "Priority no-heat service whenever possible.",
    href: "/services/emergency-heating-repair/",
    icon: "emergency"
  },
  {
    title: "Mini Split Repair",
    description: "Diagnosis and repair for ductless mini split systems.",
    href: "/services/ductless-mini-split-repair/",
    icon: "minisplit"
  }
];
---

<section class="ferndale-services">

  <div class="container">

    <div class="section-header">

      <span class="overline">
        SERVICES IN THIS CITY
      </span>

      <h2>
        What We Repair in Ferndale
      </h2>

      <p>
        The full range, same as everywhere else we work. If the heat has
        stopped or the system is behaving oddly, start here.
      </p>

    </div>

    <div class="services-grid">

      {services.map((service) => (

        <a href={service.href} class="service-card">

          <div class="icon">

            {service.icon === "furnace" && (
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="5" y="3" width="14" height="18" rx="2"/>
                <path d="M8 8h8M8 12h8M8 16h5"/>
              </svg>
            )}

            {service.icon === "heatpump" && (
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="8"/>
                <path d="M12 4v16M4 12h16M7 7l10 10M17 7L7 17"/>
              </svg>
            )}

            {service.icon === "emergency" && (
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M13 2L4 14h6l-1 8 11-14h-7z"/>
              </svg>
            )}

            {service.icon === "minisplit" && (
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3" y="6" width="18" height="7" rx="2"/>
                <path d="M7 17h10M9 20h6"/>
              </svg>
            )}

          </div>

          <h3>{service.title}</h3>

          <p>{service.description}</p>

          <span class="learn-more">
            Learn More →
          </span>

        </a>

      ))}

    </div>

  </div>

</section>

<style>

.ferndale-services{
padding:110px 24px;
background:#f8fafc;
}

.container{
width:min(1200px,100%);
margin:auto;
}

.section-header{
max-width:760px;
margin:0 auto 60px;
text-align:center;
}

.overline{
display:inline-block;
margin-bottom:18px;
color:#ea580c;
font-size:.82rem;
font-weight:800;
letter-spacing:2px;
}

.overline::after{
content:"";
display:block;
width:60px;
height:3px;
margin:10px auto 0;
background:#f97316;
border-radius:999px;
}

.section-header h2{
font-size:clamp(2.3rem,4vw,3.5rem);
margin-bottom:18px;
color:#0f172a;
}

.section-header p{
color:#64748b;
line-height:1.8;
}

.services-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:28px;
}

.service-card{
display:block;
padding:34px;
background:#fff;
border:1px solid #e5e7eb;
border-radius:22px;
text-decoration:none;
transition:.35s;
box-shadow:0 10px 30px rgba(15,23,42,.05);
}

.service-card:hover{
transform:translateY(-8px);
border-color:#f97316;
box-shadow:0 22px 50px rgba(15,23,42,.12);
}

.icon{
width:72px;
height:72px;
display:flex;
align-items:center;
justify-content:center;
margin-bottom:24px;
border-radius:18px;
background:#fff7ed;
color:#f97316;
transition:.35s;
}

.icon svg{
width:34px;
height:34px;
stroke:currentColor;
stroke-width:1.8;
stroke-linecap:round;
stroke-linejoin:round;
}

.service-card:hover .icon{
background:#f97316;
color:#fff;
transform:rotate(-5deg) scale(1.05);
}

.service-card h3{
margin:0 0 14px;
font-size:1.4rem;
color:#0f172a;
}

.service-card p{
margin:0 0 20px;
color:#64748b;
line-height:1.8;
}

.learn-more{
display:inline-flex;
align-items:center;
gap:8px;
font-weight:700;
color:#ea580c;
transition:.3s;
}

.service-card:hover .learn-more{
gap:14px;
}

@media(max-width:900px){

.services-grid{
grid-template-columns:1fr;
}

}

</style>