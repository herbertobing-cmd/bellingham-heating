---
const reasons = [
  {
    title: "No Install Sales Agenda",
    description:
      "We do not install new systems, so we have no reason to condemn your furnace. Our advice costs us nothing either way.",
    icon: "wrench",
  },
  {
    title: "We Work on Old Equipment",
    description:
      "A twenty year old furnace is not automatically a lost cause, and we will not treat it like one.",
    icon: "settings",
  },
  {
    title: "Local to Whatcom County",
    description:
      "We serve Bellingham, Ferndale, Lynden, Blaine and Everson throughout the year.",
    icon: "map",
  },
  {
    title: "Plain-Language Explanations",
    description:
      "You should understand what failed and why before you agree to pay for anything.",
    icon: "message",
  },
  {
    title: "Honest Stop-Spending Advice",
    description:
      "We will tell you to stop spending money when that is the right answer, explain what to look for in a replacement, and step out of the sale.",
    icon: "shield",
  },
];
---

<section class="furnace-why-us">
  <div class="container">
    <header class="section-header">
      <span class="overline">WHY CHOOSE US</span>
      <h2>Why Bellingham Homeowners Call Us for Furnace Repair</h2>
    </header>

    <div class="why-grid">
      {
        reasons.map((reason) => (
          <article class="why-card">
            <div class="icon-wrap" aria-hidden="true">
              {reason.icon === "wrench" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M14.7 6.3a4 4 0 0 0-5-5L7.4 3.6l3 3L8 9l-3-3-2.3 2.3a4 4 0 0 0 5 5L16 21.6a2 2 0 0 0 2.8-2.8l-8.3-8.3" />
                </svg>
              )}

              {reason.icon === "settings" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="3" />
                  <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21h-4v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3.1 14H3v-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.5V3h4v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1h.1v4h-.1a1.7 1.7 0 0 0-1.5 1Z" />
                </svg>
              )}

              {reason.icon === "map" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="m3 6 5-2 8 2 5-2v14l-5 2-8-2-5 2V6Z" />
                  <path d="M8 4v14M16 6v14" />
                </svg>
              )}

              {reason.icon === "message" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                  <path d="M8 9h8M8 13h5" />
                </svg>
              )}

              {reason.icon === "shield" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z" />
                  <path d="m8.5 12 2.3 2.3 4.7-5" />
                </svg>
              )}
            </div>

            <h3>{reason.title}</h3>
            <p>{reason.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .furnace-why-us {
    padding: 110px 24px;
    background:
      radial-gradient(circle at top left, rgba(249, 115, 22, 0.07), transparent 34%),
      #ffffff;
  }

  .container {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .section-header {
    max-width: 820px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .overline {
    display: inline-block;
    margin-bottom: 16px;
    color: #ea580c;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2.4px;
  }

  .overline::after {
    content: "";
    display: block;
    width: 64px;
    height: 3px;
    margin: 10px auto 0;
    border-radius: 999px;
    background: #f97316;
  }

  .section-header h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(2.15rem, 4vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -1.3px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }

  .why-card {
    grid-column: span 2;
    position: relative;
    min-height: 300px;
    padding: 34px;
    overflow: hidden;
    border: 1px solid #e8edf3;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 12px 34px rgba(15, 23, 42, 0.06);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .why-card:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .why-card:nth-child(5) {
    grid-column: 4 / span 2;
  }

  .why-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, #f97316, #fb923c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .why-card:hover {
    transform: translateY(-8px);
    border-color: rgba(249, 115, 22, 0.38);
    box-shadow:
      0 22px 55px rgba(15, 23, 42, 0.11),
      0 0 26px rgba(249, 115, 22, 0.1);
  }

  .why-card:hover::before {
    transform: scaleX(1);
  }

  .icon-wrap {
    display: grid;
    width: 70px;
    height: 70px;
    margin-bottom: 25px;
    place-items: center;
    border: 1px solid #fed7aa;
    border-radius: 18px;
    color: #ea580c;
    background: #fff7ed;
    transition: transform 0.3s ease, color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }
.card-icon{

width:34px;

height:34px;

stroke:currentColor;

stroke-width:2;

color:#f97316;

transition:.35s;

}

.why-card:hover .card-icon{

color:#fff;

transform:rotate(8deg) scale(1.1);

}
  .why-card:hover .icon-wrap {
    transform: translateY(-3px) scale(1.05);
    color: #ffffff;
    background: #f97316;
    box-shadow: 0 14px 30px rgba(249, 115, 22, 0.25);
  }

  .why-card h3{

transition:.35s;

}

.why-card:hover h3{

color:#f97316;

}

  .why-card p {
    margin: 0;
    color: #64748b;
    font-size: 1rem;
    line-height: 1.75;
  }

  @media (max-width: 980px) {
    .why-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why-card,
    .why-card:nth-child(4),
    .why-card:nth-child(5) {
      grid-column: auto;
    }

    .why-card:last-child {
      grid-column: 1 / -1;
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .furnace-why-us {
      padding: 82px 16px;
    }

    .section-header {
      margin-bottom: 42px;
      text-align: left;
    }

    .overline::after {
      margin-left: 0;
    }

    .why-grid {
      grid-template-columns: 1fr;
    }

   .why-card{

position:relative;

overflow:hidden;

border:2px solid #ececec;

border-radius:20px;

background:#fff;

transition:
transform .35s ease,
border-color .35s ease,
box-shadow .35s ease;

}

.why-card::before{

content:"";

position:absolute;

top:0;

left:0;

width:100%;

height:4px;

background:linear-gradient(
90deg,
#f97316,
#fb923c
);

transform:scaleX(0);

transform-origin:left;

transition:.35s;

}

.why-card:hover{

transform:translateY(-10px);

border-color:#f97316;

box-shadow:
0 0 18px rgba(249,115,22,.18),
0 18px 45px rgba(15,23,42,.12);

}

.why-card:hover::before{

transform:scaleX(1);

  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card::before,
    .icon-wrap {
      transition: none;
    }

    .why-card:hover,
    .why-card:hover .icon-wrap {
      transform: none;
    }
  }
</style>
