---
const faqs = [
  {
    question: "Do you have a shop in Ferndale?",
    answer:
      "No. We are a mobile repair service with no storefront anywhere, which keeps the diagnostic fee down. Everything we need is on the van."
  },
  {
    question: "How quickly can you get to Ferndale?",
    answer:
      "Usually the same day. Ferndale is about ten minutes from our base, so it is one of the faster addresses we serve, and no-heat calls jump the queue."
  },
  {
    question: "Do you work on the newer subdivisions as well as the older houses?",
    answer:
      "Yes. We work on both. Newer homes commonly develop control board, inducer motor and pressure switch faults, while older homes often need airflow and ductwork diagnosis."
  },
  {
    question: "Do you repair oil and propane heat out toward Custer?",
    answer:
      "Yes. We continue to repair oil and propane heating systems throughout the rural Ferndale area. Let us know your fuel type when you call so we can arrive prepared."
  },
  {
    question: "Are you licensed to work in Ferndale?",
    answer:
      "Please contact us directly if you have questions regarding licensing or current service availability."
  },
  {
    question: "How much does furnace repair cost in Ferndale?",
    answer:
      "Most repairs fall within the low hundreds. We quote the flat diagnostic fee before we travel, and if you approve the repair, that fee is applied toward the work."
  },
  {
    question: "My upstairs never gets warm. Is that the furnace?",
    answer:
      "Usually not. In many two-storey Ferndale homes this is caused by duct balancing or return-air problems rather than the furnace itself."
  }
];
---

<section class="ferndale-faq">

  <div class="container">

    <div class="section-header">

      <span class="overline">
        FREQUENTLY ASKED QUESTIONS
      </span>

      <h2>
        Heating Repair in Ferndale, Common Questions
      </h2>

      <p>
        Helpful answers to the questions homeowners in Ferndale ask us most
        often before scheduling a repair.
      </p>

    </div>

    <div class="faq-grid">

      {faqs.map((faq) => (

        <article class="faq-card">

          <h3>{faq.question}</h3>

          <p>{faq.answer}</p>

        </article>

      ))}

    </div>

  </div>

</section>

<style>

.ferndale-faq{
padding:110px 24px;
background:#f8fafc;
}

.container{
width:min(1200px,100%);
margin:auto;
}

.section-header{
max-width:760px;
margin:0 auto 60px;
text-align:center;
}

.overline{
display:inline-block;
margin-bottom:18px;
font-size:.82rem;
font-weight:800;
letter-spacing:2px;
color:#ea580c;
}

.overline::after{
content:"";
display:block;
width:60px;
height:3px;
margin:10px auto 0;
background:#f97316;
border-radius:999px;
}

.section-header h2{
margin:0 0 18px;
font-size:clamp(2.3rem,4vw,3.5rem);
color:#0f172a;
}

.section-header p{
color:#64748b;
line-height:1.8;
}

.faq-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:24px;
}

.faq-card{
padding:34px;
background:#fff;
border:1px solid #e5e7eb;
border-radius:22px;
transition:.35s;
box-shadow:0 10px 30px rgba(15,23,42,.05);
}

.faq-card:hover{
transform:translateY(-8px);
border-color:#f97316;
box-shadow:0 22px 50px rgba(15,23,42,.12);
}

.faq-card h3{
margin:0 0 16px;
font-size:1.25rem;
line-height:1.4;
color:#0f172a;
}

.faq-card p{
margin:0;
line-height:1.8;
color:#64748b;
}

@media(max-width:900px){

.faq-grid{
grid-template-columns:1fr;
}

}

</style>