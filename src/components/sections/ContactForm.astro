<section id="contact-form" class="contact-form-section">

  <div class="container">

    <div class="section-header">

      <span class="overline">
        REQUEST A VISIT
      </span>

      <h2>
        Tell Us What Your Heat Is Doing
      </h2>

      <p>
        The more detail the better. Tell us what the system is doing, roughly
        how old it is, and whether you have heat at all right now.
      </p>

    </div>

    <form class="contact-form">

      <div class="grid">

        <div class="field">
          <label>First Name <span>*</span></label>
          <input
            type="text"
            placeholder="John"
            required>
        </div>

        <div class="field">
          <label>Last Name <span>*</span></label>
          <input
            type="text"
            placeholder="Smith"
            required>
        </div>

        <div class="field">
          <label>Phone <span>*</span></label>
          <input
            type="tel"
            placeholder="(360) 555-0143"
            required>
        </div>

        <div class="field">
          <label>Email <span>*</span></label>
          <input
            type="email"
            placeholder="john@email.com"
            required>
        </div>

        <div class="field">
          <label>ZIP Code <span>*</span></label>
          <input
            type="text"
            maxlength="5"
            placeholder="98225"
            required>
        </div>

        <div class="field">
          <label>Which Service</label>

          <select>

            <option>Not Sure</option>
            <option>Furnace Repair</option>
            <option>Emergency Heating Repair</option>
            <option>Heat Pump Repair</option>
            <option>Furnace Maintenance & Tune-Up</option>
            <option>Ductless Mini Split Repair</option>

          </select>

        </div>

      </div>

      <div class="field full">

        <label>
          What Is It Doing? <span>*</span>
        </label>

        <textarea
          rows="7"
          placeholder="Describe the problem..."
          required></textarea>

      </div>

      <!-- Example Error -->

      <div class="form-error">

        Please complete all required fields.

      </div>

      <!-- Loading Example -->

      <!--
      <button class="submit-btn loading">
        Sending...
      </button>
      -->

      <!-- Success Example -->

      <!--
      <div class="form-success">
        Thanks, we have got it. We will come back to you with a time.
        If your heat is out right now, please call (360) 555-0143.
      </div>
      -->

      <button class="submit-btn">

        Send It Through

      </button>

    </form>

  </div>

</section>

<style>

.contact-form-section{

padding:110px 24px;

background:#fff;

}

