content:"";

display:block;

width:60px;

height:3px;

margin:10px auto 0;

background:#f97316;

border-radius:999px;

}

.section-header h2{

margin-bottom:20px;

font-size:clamp(2.4rem,4vw,3.6rem);

color:#0f172a;

}

.section-header p{

color:#64748b;

line-height:1.8;

}

.contact-form{

background:#fff;

padding:50px;

border-radius:24px;

border:1px solid #e5e7eb;

box-shadow:0 20px 50px rgba(15,23,42,.08);

}

.grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:24px;

}

.field{

