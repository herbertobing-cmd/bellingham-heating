<section class="furnace-hero">

  <div class="container hero-grid">

    <div class="hero-content">

      <span class="overline">
        FURNACE REPAIR SERVICES
      </span>

      <h1>
        Furnace Repair
        <span>in Bellingham</span>
      </h1>

      <p>
        No heat? Furnace blowing cold air? We diagnose and repair gas,
        electric and oil furnaces throughout Whatcom County.
        Honest repairs. No pressure to replace equipment that can still
        be repaired.
      </p>

      <div class="hero-buttons">

        <a href="#contact" class="btn btn-primary">
          BOOK A VISIT
        </a>

        <a href="tel:+13605550143" class="btn btn-outline">
          CALL (360) 555-0143
        </a>

      </div>

      <div class="hero-features">

        <div class="feature">
          ✓ Same Day Service
        </div>

        <div class="feature">
          ✓ Flat Diagnostic Fee
        </div>

        <div class="feature">
          ✓ Honest Repair Advice
        </div>

      </div>

    </div>

    <div class="hero-image">

      <img
        src="https://assets.cdn.filesafe.space/yYhT9V8bWmH856u4w7q3/media/6a725a8bc8f2b5f1cfc99bd3.png"
        alt="Furnace Repair Technician"
      />

      <div class="floating-card">

        <strong>Emergency Furnace Repair</strong>

        <span>Fast response throughout Whatcom County.</span>

      </div>

    </div>

  </div>

</section>

<style>

.furnace-hero{

padding:45px 0;

background:#f8fafc;

}

.hero-grid{

display:grid;

grid-template-columns:42% 58%;

align-items:center;

background:white;

border-radius:24px;

overflow:hidden;

box-shadow:0 25px 70px rgba(15,23,42,.08);

}

.hero-content{

padding:65px;

}

.overline{

display:inline-block;

color:#f97316;

font-size:.82rem;

font-weight:800;

letter-spacing:3px;

margin-bottom:18px;

}

.overline::after{

content:"";

display:block;

width:70px;

height:3px;

background:#f97316;

margin-top:10px;

border-radius:20px;

}

.hero-content h1{

font-size:56px;

line-height:1.05;

font-weight:900;

margin:0 0 24px;

color:#0f172a;

}

.hero-content h1 span{

display:block;

}

.hero-content p{

font-size:18px;

line-height:1.9;

color:#475569;

margin-bottom:35px;

max-width:520px;

}

.hero-buttons{

display:flex;

gap:18px;

margin-bottom:35px;

flex-wrap:wrap;

}

.btn{

padding:18px 34px;

border-radius:12px;

font-weight:800;

text-decoration:none;

transition:.35s;

}

.btn-primary{

background:#f97316;

color:white;

box-shadow:0 18px 40px rgba(249,115,22,.28);

}

.btn-primary:hover{

background:#ea580c;

transform:translateY(-4px);

}

.btn-outline{

border:2px solid #f97316;

color:#f97316;

}

.btn-outline:hover{

background:#f97316;

color:white;

}

.hero-features{

display:flex;

flex-direction:column;

gap:12px;

font-weight:700;

color:#0f172a;

}

.feature{

display:flex;

align-items:center;

gap:10px;

}

.hero-image{

position:relative;

height:560px;

overflow:hidden;

}

.hero-image img{

width:100%;

height:100%;

object-fit:cover;

object-position:center;

transition:.6s;

}

.hero-grid:hover .hero-image img{

transform:scale(1.04);

}

.hero-image::after{

content:"";

position:absolute;

inset:0;

background:linear-gradient(90deg,rgba(15,23,42,.18),transparent);

}

.floating-card{

position:absolute;

bottom:30px;

left:30px;

z-index:5;

background:white;

padding:18px 22px;

border-radius:16px;

box-shadow:0 18px 45px rgba(0,0,0,.18);

animation:floatCard 3s ease-in-out infinite;

max-width:280px;

}

.floating-card strong{

display:block;

margin-bottom:8px;

font-size:18px;

color:#0f172a;

}

.floating-card span{

color:#64748b;

font-size:15px;

line-height:1.6;

}

@keyframes floatCard{

0%,100%{

transform:translateY(0);

}

50%{

transform:translateY(-8px);

}

}

@media(max-width:991px){

.hero-grid{

grid-template-columns:1fr;

}

.hero-content{

padding:50px 35px;

}

.hero-content h1{

font-size:42px;

}

.hero-image{

height:380px;

}

}

@media(max-width:640px){

.hero-content{

padding:36px 24px;

}

.hero-content h1{

font-size:34px;

}

.hero-content p{

font-size:16px;

}

.hero-buttons{

flex-direction:column;

}

.btn{

text-align:center;

}

.hero-image{

height:300px;

}

.floating-card{

left:16px;

right:16px;

bottom:16px;

max-width:none;

}

}

</style>