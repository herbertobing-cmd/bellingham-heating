---
const items = [
  {
    title: "A Phone Triage First",
    description: "Before we dispatch anyone, we ask what the system is doing, how cold the house is, and who is in it. Sometimes that conversation ends with a two-minute fix you can do yourself.",
    icon: "phone"
  },
  {
    title: "The After-Hours Fee Before We Leave",
    description: "You get the number on the phone before we set off. There is no unexpected surcharge discovered later on the invoice.",
    icon: "receipt"
  },
  {
    title: "Heat Restored Where Possible Tonight",
    description: "Most no-heat calls come down to ignition components, safeties and controls, and those common parts travel with us.",
    icon: "flame"
  },
  {
    title: "A Clear Plan for the Morning",
    description: "If the repair needs daylight, a part, or a second person, you receive practical advice and a clear plan instead of an open question.",
    icon: "calendar"
  }
];
---

<section class="emergency-visit">
  <div class="container">
    <header class="section-header">
      <span class="overline">WHAT TO EXPECT</span>
      <h2>What Happens When We Come Out</h2>
      <p>We triage the call first, quote the after-hours fee before dispatch, restore heat where possible, and leave you with a clear next step.</p>
    </header>

    <div class="visit-layout">
      <div class="visit-image">
        <img src="/images/svc-emergency-detail.webp" alt="Wall thermostat reading a cold indoor temperature" />
        <div class="image-shade"></div>

        <div class="floating-badge">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2v20M4.2 6.5l15.6 11M19.8 6.5l-15.6 11" />
          </svg>
          <div>
            <strong>No-Heat Calls Prioritised</strong>
            <span>Evenings and weekends across Whatcom County</span>
          </div>
        </div>
      </div>

      <div class="visit-grid">
        {items.map((item) => (
          <article class="visit-card">
            <div class="icon-wrap" aria-hidden="true">
              {item.icon === "phone" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
                </svg>
              )}

              {item.icon === "receipt" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z" />
                  <path d="M9 8h6M9 12h6M9 16h3" />
                </svg>
              )}

              {item.icon === "flame" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <path d="M12 3s5 5 5 9a5 5 0 0 1-10 0c0-2.5 1.5-4.5 3-6.5.3 1.8 1.2 3 2 3.5 0-2.5 0-4 0-6Z" />
                </svg>
              )}

              {item.icon === "calendar" && (
                <svg class="card-icon" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M8 3v4M16 3v4M3 10h18M9 15l2 2 4-4" />
                </svg>
              )}
            </div>

            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.emergency-visit {
  padding: 110px 24px;
  background: radial-gradient(circle at top left, rgba(220,38,38,.08), transparent 34%), #fff;
}

.container {
  width: min(1180px, 100%);
  margin: auto;
}

.section-header {
  max-width: 810px;
  margin: 0 auto 58px;
  text-align: center;
}

.overline {
  display: inline-block;
  margin-bottom: 16px;
  color: #dc2626;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: 2.4px;
}

.overline::after {
  content: "";
  display: block;
  width: 64px;
  height: 3px;
  margin: 10px auto 0;
  border-radius: 999px;
  background: linear-gradient(90deg, #dc2626, #f97316);
}

.section-header h2 {
  margin: 0 0 20px;
  color: #0f172a;
  font-size: clamp(2.2rem, 4vw, 3.25rem);
  line-height: 1.08;
}

.section-header p {
  max-width: 700px;
  margin: auto;
  color: #64748b;
  font-size: 1.08rem;
  line-height: 1.8;
}

.visit-layout {
  display: grid;
  grid-template-columns: minmax(380px, .9fr) minmax(0, 1.1fr);
  gap: 38px;
}

.visit-image {
  position: relative;
  min-height: 590px;
  overflow: hidden;
  border-radius: 24px;
  background: #0f172a;
  box-shadow: 0 24px 65px rgba(15,23,42,.18);
}

.visit-image img {
  width: 100%;
  height: 100%;
  min-height: 590px;
  display: block;
  object-fit: cover;
  transition: transform .7s ease;
}

.visit-image:hover img {
  transform: scale(1.045);
}

.image-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 38%, rgba(15,23,42,.78));
}

.floating-badge {
  position: absolute;
  right: 24px;
  bottom: 24px;
  left: 24px;
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 19px 21px;
  border: 1px solid rgba(255,255,255,.5);
  border-radius: 17px;
  color: #fff;
  background: rgba(15,23,42,.8);
  backdrop-filter: blur(12px);
  animation: badgeFloat 3.2s ease-in-out infinite;
}

.floating-badge svg {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  color: #fb923c;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
}

.floating-badge strong,
.floating-badge span {
  display: block;
}

.floating-badge span {
  margin-top: 4px;
  color: #dbe4ef;
  font-size: .9rem;
}

.visit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.visit-card {
  position: relative;
  min-height: 275px;
  padding: 31px;
  overflow: hidden;
  border: 2px solid #e7ebf0;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15,23,42,.05);
  transition: .35s;
}

.visit-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(90deg, #dc2626, #f97316);
  transform: scaleX(0);
  transform-origin: left;
  transition: .35s;
}

.visit-card:hover {
  transform: translateY(-9px);
  border-color: #f97316;
  box-shadow: 0 0 24px rgba(249,115,22,.16), 0 22px 52px rgba(15,23,42,.12);
}

.visit-card:hover::before {
  transform: scaleX(1);
}

.icon-wrap {
  display: grid;
  width: 66px;
  height: 66px;
  margin-bottom: 23px;
  place-items: center;
  border: 1px solid #fecaca;
  border-radius: 18px;
  color: #dc2626;
  background: #fef2f2;
  animation: iconPulse 3s ease-in-out infinite;
  transition: .35s;
}

.card-icon {
  width: 32px;
  height: 32px;
  overflow: visible;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.visit-card:hover .icon-wrap {
  color: #fff;
  background: linear-gradient(135deg, #dc2626, #f97316);
  transform: translateY(-4px) scale(1.07);
  box-shadow: 0 0 20px rgba(239,68,68,.3), 0 14px 30px rgba(249,115,22,.24);
}

.visit-card h3 {
  margin: 0 0 13px;
  color: #0f172a;
  font-size: 1.28rem;
  line-height: 1.3;
}

.visit-card p {
  margin: 0;
  color: #64748b;
  line-height: 1.72;
}

@keyframes iconPulse {
  50% { transform: scale(1.055); }
}

@keyframes badgeFloat {
  50% { transform: translateY(-7px); }
}

@media (max-width: 1050px) {
  .visit-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .emergency-visit {
    padding: 82px 16px;
  }

  .section-header {
    text-align: left;
  }

  .overline::after {
    margin-left: 0;
  }

  .visit-grid {
    grid-template-columns: 1fr;
  }

  .visit-image,
  .visit-image img {
    min-height: 360px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .icon-wrap,
  .floating-badge {
    animation: none;
  }

  .visit-card:hover,
  .visit-card:hover .icon-wrap,
  .visit-image:hover img {
    transform: none;
  }
}
</style>
