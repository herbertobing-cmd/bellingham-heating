---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Bellingham Heating Repair"
  description="The page you requested could not be found."
  noindex={true}
>

  <main class="not-found-page">

    <div class="container">

      <div class="error-card">

        <div class="error-code" aria-hidden="true">
          404
        </div>

        <span class="overline">
          PAGE NOT FOUND
        </span>

        <h1>
          That Page Is Not
          <span>Where We Left It</span>
        </h1>

        <p class="intro">
          Which is annoying, but at least it is not your furnace.
        </p>

        <p class="body-copy">
          The page you were after has either moved or never existed. If you
          came here looking for help with your heating, the links below will
          get you back on track. If your heat is actually out right now, skip
          all of it and call us.
        </p>

        <div class="primary-actions">

          <a
            href="tel:+13605550143"
            class="btn btn-primary"
          >
            Call (360) 555-0143
          </a>

          <a
            href="/"
            class="btn btn-secondary"
          >
            Back to Homepage
          </a>

        </div>

        <nav class="help-links" aria-label="Helpful links">

          <a href="/services/">
            Browse Services
          </a>

          <a href="/service-areas/">
            Areas We Serve
          </a>

          <a href="/contact/">
            Contact Us
          </a>

        </nav>

        <div class="status-note">

          <div class="status-icon" aria-hidden="true">

            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 12h16" />
              <path d="M12 4v16" />
              <circle cx="12" cy="12" r="9" />
            </svg>

          </div>

          <div>
            <strong>Need heating help?</strong>
            <span>
              Same-day service is available most days across Whatcom County.
            </span>
          </div>

        </div>

      </div>

    </div>

  </main>

</BaseLayout>

<style>
.not-found-page {
  min-height: calc(100vh - 90px);
  display: grid;
  place-items: center;
  padding: 90px 24px;
  background:
    radial-gradient(
      circle at top left,
      rgba(249, 115, 22, 0.12),
      transparent 32%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(15, 23, 42, 0.08),
      transparent 34%
    ),
    #f8fafc;
}

.container {
  width: min(940px, 100%);
  margin: 0 auto;
}

.error-card {
  position: relative;
  overflow: hidden;
  padding: 72px;
  text-align: center;
  border: 1px solid #e2e8f0;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 30px 80px rgba(15, 23, 42, 0.12);
}

.error-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 5px;
  background: linear-gradient(
    90deg,
    #ea580c,
    #f97316,
    #fb923c
  );
}

.error-code {
  position: absolute;
  top: -44px;
  right: 24px;
  color: rgba(15, 23, 42, 0.035);
  font-size: clamp(9rem, 24vw, 18rem);
  font-weight: 900;
  line-height: 1;
  pointer-events: none;
}

.overline {
  position: relative;
  display: inline-block;
  margin-bottom: 18px;
  color: #ea580c;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 2.2px;
}

.overline::after {
  content: "";
  display: block;
  width: 64px;
  height: 3px;
  margin: 10px auto 0;
  border-radius: 999px;
  background: #f97316;
}

h1 {
  position: relative;
  margin: 0 0 22px;
  color: #0f172a;
  font-size: clamp(2.7rem, 6vw, 4.8rem);
  line-height: 1.05;
  letter-spacing: -1.5px;
}

h1 span {
  display: block;
  color: #ea580c;
}

.intro {
  position: relative;
  margin: 0 0 14px;
  color: #334155;
  font-size: 1.25rem;
  font-weight: 700;
}

.body-copy {
  position: relative;
  max-width: 690px;
  margin: 0 auto 36px;
  color: #64748b;
  font-size: 1.06rem;
  line-height: 1.85;
}

.primary-actions {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 34px;
}

.btn {
  display: inline-flex;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  padding: 16px 30px;
  border-radius: 14px;
  font-weight: 800;
  text-decoration: none;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    box-shadow 0.3s ease;
}

.btn-primary {
  color: #ffffff;
  background: #f97316;
  box-shadow:
    0 18px 38px rgba(249, 115, 22, 0.28);
}

.btn-primary:hover {
  transform: translateY(-4px);
  background: #ea580c;
  box-shadow:
    0 24px 48px rgba(249, 115, 22, 0.36);
}

.btn-secondary {
  border: 2px solid #e2e8f0;
  color: #0f172a;
  background: #ffffff;
}

.btn-secondary:hover {
  transform: translateY(-4px);
  border-color: #0f172a;
  color: #ffffff;
  background: #0f172a;
}

.help-links {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;
  margin-bottom: 38px;
}

.help-links a {
  color: #475569;
  font-weight: 700;
  text-decoration: none;
  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.help-links a:hover {
  color: #ea580c;
  transform: translateY(-2px);
}

.status-note {
  position: relative;
  display: flex;
  max-width: 620px;
  align-items: center;
  gap: 16px;
  margin: 0 auto;
  padding: 20px 22px;
  text-align: left;
  border: 1px solid #fed7aa;
  border-radius: 18px;
  background: #fff7ed;
}

.status-icon {
  display: grid;
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 14px;
  color: #ea580c;
  background: #ffffff;
}

.status-icon svg {
  width: 27px;
  height: 27px;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.status-note strong,
.status-note span {
  display: block;
}

.status-note strong {
  margin-bottom: 4px;
  color: #9a3412;
}

.status-note span {
  color: #7c2d12;
  line-height: 1.55;
}

@media (max-width: 700px) {
  .not-found-page {
    padding: 70px 16px;
  }

  .error-card {
    padding: 54px 24px 34px;
  }

  .error-code {
    top: -18px;
    right: 4px;
  }

  .primary-actions {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .help-links {
    flex-direction: column;
    gap: 14px;
  }

  .status-note {
    align-items: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  .btn,
  .help-links a {
    transition: none;
  }

  .btn:hover,
  .help-links a:hover {
    transform: none;
  }
}
</style>